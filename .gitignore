*.moved-aside
*.perspectivev3
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved
*.playground/

