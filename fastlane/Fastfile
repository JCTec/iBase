# iBase release automation.
#
# Always invoke through `bundle exec fastlane …` so local runs and CI use the pinned version.
#
# Two things about this repository shape the whole file, both recorded in
# docs/RELEASE_AUTOMATION.md:
#
#   1. `iBase.xcodeproj` is generated by XcodeGen and is git-ignored. A fresh clone has no project
#      at all, so every lane that touches Xcode regenerates it first.
#   2. There is no pre-existing signing path to wrap. `CODE_SIGNING_ALLOWED` is `NO` on every target
#      so CI can build without credentials. Release lanes therefore turn signing back on explicitly
#      rather than inheriting it.

require "shellwords"

default_platform(:ios)

# --- Project constants -------------------------------------------------------------------------
# Overridable so the file stays portable, with this repository's values as defaults.

SCHEME              = ENV["IBASE_SCHEME"]          || "iBase"
PROJECT             = ENV["IBASE_PROJECT"]         || "iBase.xcodeproj"
UNIT_TEST_TARGET    = ENV["IBASE_UNIT_TESTS"]      || "iBaseTests"
UI_TEST_TARGET      = ENV["IBASE_UI_TESTS"]        || "iBaseUITests"

IPHONE_DESTINATION  = ENV["IBASE_IPHONE_DEVICE"]   || "iPhone 17 Pro"
IPAD_DESTINATION    = ENV["IBASE_IPAD_DEVICE"]     || "iPad Pro 13-inch (M5)"

BUILD_DIR           = "build"
DERIVED_DATA        = "build/DerivedData"

# The iPad leg mirrors .github/workflows/ci.yml: the full unit suite plus the two UI journeys that
# are meaningful on a regular-width layout. Running the whole UI suite twice buys nothing.
IPAD_UI_TESTS = [
  "#{UI_TEST_TARGET}/iBaseUITests/testConvertCommitReloadAndDeleteJourney",
  "#{UI_TEST_TARGET}/iBaseUITests/testSettingsControlsWhichBaseRowsAppear"
].freeze

# --- Helpers -----------------------------------------------------------------------------------

def repo_root
  File.expand_path("..", __dir__)
end

# The .xcodeproj is not committed. Regenerating is cheap and idempotent, and skipping it is the
# single most likely way for a lane to fail on a clean checkout.
def ensure_project!
  unless system("command -v xcodegen > /dev/null 2>&1")
    UI.user_error!(
      "xcodegen is not installed, and #{PROJECT} is generated from project.yml (it is git-ignored).\n" \
      "Install it with:  brew install xcodegen"
    )
  end

  UI.message("Generating #{PROJECT} from project.yml")
  sh("cd #{repo_root.shellescape} && xcodegen generate")
end

# Fails before any slow work happens, naming every missing variable at once rather than one per run.
def require_env!(*names)
  missing = names.reject { |name| ENV[name].to_s.strip != "" }
  return if missing.empty?

  UI.user_error!(
    "Missing required environment variable#{missing.count > 1 ? 's' : ''}: #{missing.join(', ')}\n" \
    "See the \"Required secrets\" section of docs/RELEASE_AUTOMATION.md for how to obtain each."
  )
end

# An App Store Connect API key, not an Apple ID and password: no two-factor prompt, survives a
# password change, and is the only workable option in CI.
def asc_api_key
  require_env!("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_CONTENT")

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false
  )
end

def require_team_id!
  require_env!("IBASE_TEAM_ID")
  ENV["IBASE_TEAM_ID"]
end

# Signing strategy — the reasoning is in the "Signing" section of docs/RELEASE_AUTOMATION.md.
#
# match is the recommendation for CI and the only reliable way to hand a runner a signing identity.
# It is deliberately NOT mandatory: this repository already builds and signs locally from the
# certificates in the developer's keychain, and forcing match on a solo developer cutting releases
# from one machine buys a second repository and a shared passphrase for nothing.
#
# So: use match when MATCH_GIT_URL is set, fall back to the local keychain when it is not — and
# refuse to guess on CI, where there is no keychain worth falling back to.
def setup_signing!(type:)
  setup_ci if ENV["CI"]

  if ENV["MATCH_GIT_URL"].to_s.strip.empty?
    if ENV["CI"]
      UI.user_error!(
        "Running on CI with no signing identity.\n" \
        "Set MATCH_GIT_URL and MATCH_PASSWORD, or this lane cannot sign anything.\n" \
        "See the \"Signing\" section of docs/RELEASE_AUTOMATION.md."
      )
    end

    UI.important(
      "MATCH_GIT_URL is not set — signing with the identities already in this machine's keychain.\n" \
      "Fine for a local release. For CI, set up match."
    )
    return
  end

  require_env!("MATCH_PASSWORD")

  match(
    type: type,
    readonly: true, # lanes consume certificates; they never mint or revoke them
    git_url: ENV["MATCH_GIT_URL"],
    api_key: asc_api_key
  )
end

# --- Cross-platform validation -----------------------------------------------------------------

desc "Build and run the full validation suite on every platform this project targets"
lane :test do
  ensure_project!

  UI.header("iOS — iPhone")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=iOS Simulator,name=#{IPHONE_DESTINATION}",
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/iphone",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  UI.header("iOS — iPad")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=iOS Simulator,name=#{IPAD_DESTINATION}",
    only_testing: [UNIT_TEST_TARGET] + IPAD_UI_TESTS,
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/ipad",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  # UI tests are iOS-only here by design: the journey drives swipe-to-delete, which has no reliable
  # AppKit equivalent, and the macOS UI-test runner needs a signed runner plus accessibility
  # permission. macOS still builds and runs the full unit suite.
  UI.header("macOS")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=macOS",
    only_testing: [UNIT_TEST_TARGET],
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/macos",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  UI.success("All platforms validated.")
end

desc "Fetch signing certificates and profiles via match (read-only). Requires MATCH_GIT_URL."
lane :certificates do
  require_env!("MATCH_GIT_URL", "MATCH_PASSWORD")

  ["appstore", "development", "developer_id"].each do |type|
    match(type: type, readonly: true, git_url: ENV["MATCH_GIT_URL"], api_key: asc_api_key)
  end

  UI.success("Certificates and profiles are in place.")
end

# --- iOS ----------------------------------------------------------------------------------------

platform :ios do
  desc "Capture and frame App Store screenshots (iPhone + iPad simulators)"
  lane :screenshots do
    ensure_project!

    capture_ios_screenshots(
      project: PROJECT,
      scheme: SCHEME,
      derived_data_path: DERIVED_DATA
    )

    frame_screenshots(path: "#{BUILD_DIR}/screenshots", use_platform: "IOS")

    UI.success("Screenshots in #{BUILD_DIR}/screenshots")
  end

  desc "Build, sign, and upload a build to TestFlight"
  lane :beta do |options|
    ensure_project!
    api_key = asc_api_key
    team_id = require_team_id!
    setup_signing!(type: "appstore")

    increment_build_number_if_requested(options)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      derived_data_path: DERIVED_DATA,
      output_directory: "#{BUILD_DIR}/ios",
      output_name: "#{SCHEME}.ipa",
      buildlog_path: "#{BUILD_DIR}/logs",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "#{BUILD_DIR}/ios/#{SCHEME}.ipa",
      changelog: options[:changelog] || default_changelog,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )

    UI.success("Uploaded to TestFlight.")
  end

  desc "Build, sign, and upload to App Store Connect. Does NOT submit for review."
  lane :release do |options|
    ensure_project!
    api_key = asc_api_key
    team_id = require_team_id!
    setup_signing!(type: "appstore")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      derived_data_path: DERIVED_DATA,
      output_directory: "#{BUILD_DIR}/ios",
      output_name: "#{SCHEME}.ipa",
      buildlog_path: "#{BUILD_DIR}/logs",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES"
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "#{BUILD_DIR}/ios/#{SCHEME}.ipa",
      # Submission stays a deliberate human act. Flip with `submit:true` only when you mean it.
      submit_for_review: options[:submit] || false,
      automatic_release: false,
      force: true, # skip the HTML preview, which cannot be confirmed in CI
      skip_metadata: options[:skip_metadata].nil? ? false : options[:skip_metadata],
      skip_screenshots: options[:skip_screenshots].nil? ? false : options[:skip_screenshots],
      precheck_include_in_app_purchases: false
    )

    UI.success("Uploaded to App Store Connect. Review submission was NOT triggered.")
  end
end

# --- macOS --------------------------------------------------------------------------------------
#
# Two distribution shapes, deliberately kept apart. They are not interchangeable:
#
#   Mac App Store   — sandboxed; entitlements authorised by an embedded provisioning profile.
#   Developer ID    — signed with a Developer ID certificate and notarized; CANNOT carry App
#                     Store-only entitlements unless a profile authorises them. Signing App
#                     Store-shaped entitlements with a Developer ID certificate produces a binary
#                     the kernel terminates the instant it launches.
#
# Hence a separate entitlements file per channel, and a precondition check before each build.

platform :mac do
  desc "Build a sandboxed Mac App Store build and upload it to App Store Connect"
  lane :release do |options|
    ensure_project!
    assert_entitlements!(MAC_APP_STORE_ENTITLEMENTS, requires: "com.apple.security.app-sandbox",
                         because: "the Mac App Store rejects any app that is not sandboxed")
    api_key = asc_api_key
    team_id = require_team_id!
    setup_signing!(type: "appstore")

    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      derived_data_path: DERIVED_DATA,
      output_directory: "#{BUILD_DIR}/mac-appstore",
      buildlog_path: "#{BUILD_DIR}/logs",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES " \
              "CODE_SIGN_ENTITLEMENTS=#{MAC_APP_STORE_ENTITLEMENTS}"
    )

    upload_to_app_store(
      api_key: api_key,
      platform: "osx",
      pkg: Dir["#{BUILD_DIR}/mac-appstore/*.pkg"].first,
      submit_for_review: options[:submit] || false,
      automatic_release: false,
      force: true,
      skip_screenshots: true # no automated macOS screenshots — see docs/RELEASE_AUTOMATION.md
    )

    UI.success("Uploaded Mac App Store build. Review submission was NOT triggered.")
  end

  desc "Build a Developer ID build, notarize it, staple the ticket, and verify with Gatekeeper"
  lane :release_developer_id do
    ensure_project!
    assert_entitlements!(MAC_DEVELOPER_ID_ENTITLEMENTS, forbids: "com.apple.developer.icloud",
                         because: "a Developer ID certificate cannot authorise App Store-only " \
                                  "entitlements, and the kernel kills the app at launch if it tries")
    assert_hardened_runtime!
    api_key = asc_api_key
    team_id = require_team_id!
    setup_signing!(type: "developer_id")

    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "developer-id",
      derived_data_path: DERIVED_DATA,
      output_directory: "#{BUILD_DIR}/mac-developer-id",
      buildlog_path: "#{BUILD_DIR}/logs",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES " \
              "ENABLE_HARDENED_RUNTIME=YES " \
              "CODE_SIGN_ENTITLEMENTS=#{MAC_DEVELOPER_ID_ENTITLEMENTS}"
    )

    app_path = Dir["#{BUILD_DIR}/mac-developer-id/*.app"].first
    UI.user_error!("No .app produced in #{BUILD_DIR}/mac-developer-id") if app_path.nil?

    # Uploads, polls until Apple returns a verdict, and staples the ticket on success.
    notarize(
      package: app_path,
      api_key: asc_api_key_hash_for_notarize(api_key),
      print_log: true,
      verbose: true
    )

    verify_gatekeeper!(app_path)

    UI.success("Notarized, stapled, and accepted by Gatekeeper: #{app_path}")
  end
end

# --- macOS helpers ------------------------------------------------------------------------------

MAC_APP_STORE_ENTITLEMENTS    = "iBase/iBase-macOS-AppStore.entitlements".freeze
MAC_DEVELOPER_ID_ENTITLEMENTS = "iBase/iBase-macOS-DeveloperID.entitlements".freeze

def assert_entitlements!(relative_path, requires: nil, forbids: nil, because:)
  path = File.join(repo_root, relative_path)

  unless File.exist?(path)
    UI.user_error!("Missing entitlements file #{relative_path}.\n#{because}.")
  end

  contents = File.read(path)

  if requires && !contents.include?(requires)
    UI.user_error!(
      "#{relative_path} does not declare #{requires}.\n#{because.capitalize}."
    )
  end

  if forbids && contents.include?(forbids)
    UI.user_error!(
      "#{relative_path} declares #{forbids}, which this channel cannot carry.\n#{because.capitalize}."
    )
  end
end

# Notarization is refused outright without the hardened runtime, and the error Apple returns is
# unhelpfully generic — so check first and say exactly what to add.
def assert_hardened_runtime!
  project_yml = File.read(File.join(repo_root, "project.yml"))
  return if project_yml.include?("ENABLE_HARDENED_RUNTIME")

  UI.user_error!(
    "Hardened Runtime is not enabled, and Apple will refuse to notarize without it.\n" \
    "Add to the macOS settings in project.yml:  ENABLE_HARDENED_RUNTIME: YES"
  )
end

def verify_gatekeeper!(app_path)
  UI.message("Verifying the stapled ticket")
  sh("xcrun stapler validate #{app_path.shellescape}")

  UI.message("Asking Gatekeeper to assess the app")
  # For a .app the default context is correct. A disk image needs
  # `--context context:primary-signature`, or spctl reports a misleading failure regardless of the
  # artifact's real state.
  sh("spctl --assess --type execute --verbose=4 #{app_path.shellescape}")
end

# `notarize` wants the raw key details rather than the Spaceship object `app_store_connect_api_key`
# returns, so unwrap it here instead of at three call sites.
def asc_api_key_hash_for_notarize(api_key)
  {
    key_id: api_key[:key_id],
    issuer_id: api_key[:issuer_id],
    key: api_key[:key]
  }
end

# --- Shared helpers -----------------------------------------------------------------------------

def default_changelog
  # A build with no changelog is unhelpful to testers, but a lane that stops to ask is unusable in
  # CI — so fall back to the commit subject, which is always present and always accurate.
  sh("cd #{repo_root.shellescape} && git log -1 --pretty=%s", log: false).strip
end

def increment_build_number_if_requested(options)
  return unless options[:bump]

  # The build number lives in project.yml (CURRENT_PROJECT_VERSION), not in a plist, so the usual
  # `increment_build_number` action does not apply. Handled explicitly rather than silently skipped.
  UI.important(
    "`bump:true` was requested, but the build number is set by project.yml " \
    "(CURRENT_PROJECT_VERSION) and regenerated by XcodeGen on every run.\n" \
    "Edit project.yml and commit, rather than mutating a generated project."
  )
  UI.user_error!("Refusing to bump a generated project's build number in place.")
end
