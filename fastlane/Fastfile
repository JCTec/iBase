# iBase automation.
#
# Always invoke through `bundle exec fastlane …` so local runs and CI use the pinned version.
#
# Scope, deliberately: **validate and produce screenshots.** Nothing here signs, archives, or
# uploads. Distribution is done locally from a machine whose keychain already holds the
# certificates — so no lane needs an App Store Connect key, a match repository, or a distribution
# certificate, and CI needs no secrets at all.
#
# One thing about this repository shapes every lane: `iBase.xcodeproj` is generated by XcodeGen and
# is git-ignored. A fresh clone has no project at all, so anything touching Xcode regenerates first.

require "shellwords"

default_platform(:ios)

# --- Project constants -------------------------------------------------------------------------
# Overridable so the file stays portable, with this repository's values as defaults.

SCHEME              = ENV["IBASE_SCHEME"]          || "iBase"
PROJECT             = ENV["IBASE_PROJECT"]         || "iBase.xcodeproj"
UNIT_TEST_TARGET    = ENV["IBASE_UNIT_TESTS"]      || "iBaseTests"
UI_TEST_TARGET      = ENV["IBASE_UI_TESTS"]        || "iBaseUITests"

IPHONE_DESTINATION  = ENV["IBASE_IPHONE_DEVICE"]   || "iPhone 17 Pro"
IPAD_DESTINATION    = ENV["IBASE_IPAD_DEVICE"]     || "iPad Pro 13-inch (M5)"

BUILD_DIR           = "build"
DERIVED_DATA        = "build/DerivedData"

# Parity with ci.yml's `-retry-tests-on-failure -test-iterations 2`. One retry, not a licence for
# flaky tests: a simulator app launch can time out on a loaded runner for reasons that have nothing
# to do with the app, and this lane is the long pole of the release job — a single transient launch
# failure otherwise costs the whole forty-minute run.
TEST_RETRIES = 1

# Both legs mirror .github/workflows/ci.yml — the two must not drift, or a lane passes on push and
# fails at tag time (or the reverse).
#
# iPhone: the unit suite plus the behavioural UI class, and deliberately *not* `ScreenshotUITests`.
# Capture belongs to the `screenshots` lane, which is where the images are actually collected.
# Naming the whole `iBaseUITests` target here instead adds four more app launches to a leg that
# already launches six, and that is precisely how the tag run for v2.0.0 died: "Failed to launch …
# via Xcode: Timed out while launching application via Xcode", then a hang until the job hit its
# 60-minute ceiling. ci.yml was scoped for this in 466fc2a; this lane was missed.
IPHONE_TESTS = [
  UNIT_TEST_TARGET,
  "#{UI_TEST_TARGET}/iBaseUITests"
].freeze

# iPad: the full unit suite plus the two UI journeys that are meaningful on a regular-width layout.
# Running the whole UI suite twice buys nothing.
IPAD_TESTS = [
  UNIT_TEST_TARGET,
  "#{UI_TEST_TARGET}/iBaseUITests/testConvertCommitReloadAndDeleteJourney",
  "#{UI_TEST_TARGET}/iBaseUITests/testSettingsControlsWhichBaseRowsAppear"
].freeze

# --- Helpers -----------------------------------------------------------------------------------

def repo_root
  File.expand_path("..", __dir__)
end

# The .xcodeproj is not committed. Regenerating is cheap and idempotent, and skipping it is the
# single most likely way for a lane to fail on a clean checkout.
def ensure_project!
  unless system("command -v xcodegen > /dev/null 2>&1")
    UI.user_error!(
      "xcodegen is not installed, and #{PROJECT} is generated from project.yml (it is git-ignored).\n" \
      "Install it with:  brew install xcodegen"
    )
  end

  UI.message("Generating #{PROJECT} from project.yml")
  sh("cd #{repo_root.shellescape} && xcodegen generate")
end

# --- Validation --------------------------------------------------------------------------------

desc "Build and run the full validation suite on every platform this project targets"
lane :test do
  ensure_project!

  UI.header("iOS — iPhone")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=iOS Simulator,name=#{IPHONE_DESTINATION}",
    only_testing: IPHONE_TESTS,
    number_of_retries: TEST_RETRIES,
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/iphone",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  UI.header("iOS — iPad")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=iOS Simulator,name=#{IPAD_DESTINATION}",
    only_testing: IPAD_TESTS,
    number_of_retries: TEST_RETRIES,
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/ipad",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  # UI tests are iOS-only by design: the journey drives swipe-to-delete, which has no reliable
  # AppKit equivalent, and the macOS UI-test runner needs a signed runner plus accessibility
  # permission. macOS still builds and runs the full unit suite.
  UI.header("macOS")
  run_tests(
    project: PROJECT,
    scheme: SCHEME,
    destination: "platform=macOS",
    only_testing: [UNIT_TEST_TARGET],
    number_of_retries: TEST_RETRIES,
    derived_data_path: DERIVED_DATA,
    result_bundle: true,
    output_directory: "#{BUILD_DIR}/test-results/macos",
    buildlog_path: "#{BUILD_DIR}/logs",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )

  UI.success("All platforms validated.")
end

# --- Screenshots -------------------------------------------------------------------------------

platform :ios do
  desc "Capture App Store screenshots and compose the branded store images"
  lane :screenshots do
    ensure_project!

    # snapshot drives XCUITest against simulators; devices, locales, and the status-bar override
    # live in fastlane/Snapfile.
    capture_ios_screenshots(
      project: PROJECT,
      scheme: SCHEME,
      derived_data_path: DERIVED_DATA
    )

    # The store images need background, eyebrow, and headline copy, which is what the composer
    # draws — and it fails loudly if a headline cannot be fitted legibly rather than letting it
    # collide with the device shot. Wrapped, not reimplemented: the script already produces the
    # branded output, so the lane calls it instead of duplicating it in Ruby.
    sh("cd #{repo_root.shellescape} && swift Scripts/generate_appstore_assets.swift")

    UI.success("Raw captures in #{BUILD_DIR}/screenshots; store images in AppStoreAssets/")
  end
end
