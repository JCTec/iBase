# Copy to `fastlane/.env` and fill in. That file is git-ignored — never commit it.
#
#   cp fastlane/.env.example fastlane/.env
#
# fastlane loads `fastlane/.env` automatically, so `bundle exec fastlane ios beta` picks these up
# with no extra step. In CI these same names come from repository secrets instead; see
# docs/RELEASE_AUTOMATION.md.

# --- App Store Connect API key -----------------------------------------------------------------
# App Store Connect → Users and Access → Integrations → App Store Connect API → generate a key with
# the "App Manager" role. The .p8 downloads exactly once; keep the original in a password manager.
#
# ASC_KEY_CONTENT is the base64 of the .p8 file, not a path to it:
#   base64 -i ~/Downloads/AuthKey_ABC123XYZ.p8 | pbcopy
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=

# --- Team --------------------------------------------------------------------------------------
# Developer portal → Membership. The Developer ID certificate already on this machine belongs to
# team S8662L649U, which is likely the right value.
IBASE_TEAM_ID=

# Only if the App Store Connect team differs from the developer team (rare for individual accounts).
# IBASE_ITC_TEAM_ID=

# --- match (optional locally, REQUIRED in CI) ---------------------------------------------------
# Leave blank to sign with the certificates already in this machine's keychain — fine for cutting a
# release locally. `setup_signing!` refuses to fall back to a keychain on CI, so CI needs these.
#
#   bundle exec fastlane match init
#   bundle exec fastlane match appstore        # and: development, developer_id
MATCH_GIT_URL=
MATCH_PASSWORD=
